{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/discovery-candidate.schema.json",
  "title": "MFTL Discovery Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","candidate_id","name","region","tradition","discovery","sources","status"],
  "properties": {
    "schema_version": {"const":"candidate.v0.1"},
    "candidate_id": {"type":"string","pattern":"^CAND-[A-Z0-9-]+$"},
    "name": {"type":"string","minLength":1},
    "aliases": {"type":"array","items":{"type":"string"}},
    "region": {"type":"string","minLength":1},
    "country": {"type":["string","null"]},
    "tradition": {"type":"string","minLength":1},
    "candidate_type": {"type":"string"},
    "discovery": {
      "type":"object",
      "required":["summary","why_relevant","discovered_at"],
      "properties":{
        "summary":{"type":"string"},
        "why_relevant":{"type":"string"},
        "discovered_at":{"type":"string","format":"date-time"},
        "search_terms":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "sources": {
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["title","locator","source_type"],
        "properties":{
          "title":{"type":"string"},
          "locator":{"type":"string"},
          "source_type":{"type":"string"},
          "authority":{"enum":["primary","academic","institutional","reference","discovery_only"]},
          "notes":{"type":["string","null"]}
        },
        "additionalProperties":false
      }
    },
    "duplicate_check": {
      "type":"object",
      "properties":{
        "checked":{"type":"boolean"},
        "possible_matches":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "status":{"enum":["discovered","needs_sources","ready_for_record","rejected","merged"]},
    "notes":{"type":["string","null"]}
  }
}
