{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/myth-record.schema.json",
  "title": "MFTL Myth Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "identity",
    "classification",
    "geography",
    "narrative",
    "sources",
    "evidence",
    "assessments",
    "quality",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "myth.v0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^MYTH-[A-Z0-9-]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_name",
        "record_type"
      ],
      "properties": {
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "native_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "record_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "domain",
        "tradition"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "tradition": {
          "type": "string"
        },
        "myth_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "geography": {
      "type": "object",
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/location"
        },
        "spread": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "earliest_attestation": {
          "$ref": "#/$defs/dateClaim"
        },
        "active_periods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "precision": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "required": [
        "summary",
        "motifs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "long_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "practices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/practice"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cosmology": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_quality",
        "historical_attestation"
      ],
      "properties": {
        "source_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "historical_attestation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "historicity": {
      "type": "object",
      "properties": {
        "entity_historical_person": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "belief_historically_attested": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ritual_historically_attested": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "assessments": {
      "type": "object",
      "required": [
        "academic",
        "theological"
      ],
      "properties": {
        "academic": {
          "type": "object",
          "required": [
            "classification"
          ],
          "properties": {
            "classification": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "theological": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_assessed",
                "assessed"
              ]
            },
            "framework": {
              "type": [
                "string",
                "null"
              ]
            },
            "shirk_analysis": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/shirkAnalysis"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "record_status",
        "confidence",
        "needs_review"
      ],
      "properties": {
        "record_status": {
          "enum": [
            "discovered",
            "sourced",
            "reviewed",
            "assessed",
            "published"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at",
        "dataset"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "dataset": {
          "const": "world-myth-corpus"
        },
        "created_by": {
          "type": "string"
        },
        "last_research_run": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "name": {
      "type": "object",
      "required": [
        "name",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "script": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "country",
        "region"
      ],
      "properties": {
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "locality": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lon": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "dateClaim": {
      "type": "object",
      "required": [
        "value",
        "precision"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "range",
            "unknown"
          ]
        },
        "era": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "entityRef": {
      "type": "object",
      "required": [
        "entity_id",
        "name",
        "entity_type"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "entity_type": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "object",
        "claim_type",
        "source_basis"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "object": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "claim_type": {
          "type": "string"
        },
        "source_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "practice": {
      "type": "object",
      "required": [
        "id",
        "type",
        "description",
        "status",
        "source_basis"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "target_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "historically_attested",
            "reported",
            "contested",
            "unknown"
          ]
        },
        "source_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "source_type",
        "title",
        "primary_source",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "primary_text",
            "inscription",
            "archaeology",
            "academic_book",
            "academic_article",
            "museum",
            "reference_work",
            "institutional",
            "other"
          ]
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_source": {
          "type": "boolean"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "shirkAnalysis": {
      "type": "object",
      "required": [
        "status",
        "dimensions",
        "overall_score",
        "assessment_basis",
        "confidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "NO_MATCH",
            "PARTIAL_MATCH",
            "MATCH",
            "CONTEXT_REQUIRED"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "match",
              "score",
              "evidence_claim_ids"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^S[0-9]{2}$"
              },
              "match": {
                "enum": [
                  true,
                  false,
                  "unknown",
                  "context_required"
                ]
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "evidence_claim_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "overall_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "assessment_basis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "corpus",
              "reference",
              "relationship"
            ],
            "properties": {
              "corpus": {
                "enum": [
                  "quran",
                  "torah",
                  "psalms",
                  "gospel"
                ]
              },
              "reference": {
                "type": "string"
              },
              "relationship": {
                "enum": [
                  "normative_rule",
                  "comparative_pattern",
                  "supports",
                  "contradicts",
                  "context"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
