{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/entity-record.schema.json",
  "title": "MFTL Entity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "canonical_name",
    "entity_type",
    "traditions",
    "source_basis",
    "status",
    "confidence",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "entity.v0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^ENTITY-[A-Z0-9-]+$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "language"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "script": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "traditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "sourced",
        "reviewed",
        "disputed",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
