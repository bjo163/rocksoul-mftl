{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/epistemic-benchmark.schema.json",
  "title": "MFTL Epistemic Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "target_slots",
    "principle",
    "acceptance",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "const": "epistemic-benchmark.v0.1"
    },
    "id": {
      "type": "string"
    },
    "target_slots": {
      "const": 25
    },
    "principle": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "slots": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "ref",
          "failure_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BENCH-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "canonical",
              "candidate",
              "research_issue"
            ]
          },
          "ref": {
            "type": "string"
          },
          "failure_mode": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
