{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/mftl-record.schema.json",
  "title": "MFTL General Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","family","record_type","title","summary","source_basis","status","confidence","metadata"],
  "properties": {
    "schema_version": {"const":"mftl-record.v0.1"},
    "id": {"type":"string","pattern":"^[A-Z][A-Z0-9-]+$"},
    "family": {"type":"string","pattern":"^F(0[1-9]|1[0-8])$"},
    "record_type": {"type":"string","minLength":1},
    "title": {"type":"string","minLength":1},
    "aliases": {"type":"array","items":{"type":"string"}},
    "summary": {"type":"string","minLength":1},
    "description": {"type":["string","null"]},
    "geography": {
      "type":["object","null"],
      "properties":{
        "region":{"type":["string","null"]},
        "country":{"type":["string","null"]},
        "locality":{"type":["string","null"]},
        "lat":{"type":["number","null"]},
        "lon":{"type":["number","null"]}
      },
      "additionalProperties":false
    },
    "chronology": {
      "type":["object","null"],
      "properties":{
        "from":{"type":["string","null"]},
        "to":{"type":["string","null"]},
        "precision":{"enum":["exact","approximate","range","unknown"]}
      },
      "additionalProperties":false
    },
    "tags":{"type":"array","items":{"type":"string"}},
    "claim_ids":{"type":"array","items":{"type":"string"}},
    "practice_ids":{"type":"array","items":{"type":"string"}},
    "entity_ids":{"type":"array","items":{"type":"string"}},
    "event_ids":{"type":"array","items":{"type":"string"}},
    "source_basis":{"type":"array","items":{"type":"string"}},
    "evidence_ids":{"type":"array","items":{"type":"string"}},
    "relation_ids":{"type":"array","items":{"type":"string"}},
    "assessment_ids":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["discovered","sourced","reviewed","assessed","published","disputed","deprecated"]},
    "confidence":{"type":["number","null"],"minimum":0,"maximum":1},
    "metadata":{
      "type":"object",
      "required":["created_at","updated_at"],
      "properties":{
        "created_at":{"type":"string","format":"date-time"},
        "updated_at":{"type":"string","format":"date-time"},
        "created_by":{"type":["string","null"]},
        "last_research_run":{"type":["string","null"],"format":"date-time"}
      },
      "additionalProperties":false
    }
  }
}
