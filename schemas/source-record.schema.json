{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/source-record.schema.json",
  "title": "MFTL Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","source_type","title","locators","authority","status","metadata"],
  "properties": {
    "schema_version":{"const":"source.v0.1"},
    "id":{"type":"string","pattern":"^SOURCE-[A-Z0-9-]+$"},
    "source_type":{"enum":["primary_text","manuscript","inscription","archaeology","academic_book","academic_article","museum","library","archive","reference_work","institutional","news","media","website","witness_report","other"]},
    "title":{"type":"string","minLength":1},
    "creator":{"type":["string","null"]},
    "publisher":{"type":["string","null"]},
    "date":{"type":["string","null"]},
    "languages":{"type":"array","items":{"type":"string"}},
    "locators":{
      "type":"array","minItems":1,
      "items":{
        "type":"object",
        "required":["type","value"],
        "properties":{
          "type":{"enum":["url","doi","isbn","oclc","archive_id","museum_id","manuscript_id","catalog_id","citation","other"]},
          "value":{"type":"string","minLength":1},
          "accessed_at":{"type":["string","null"],"format":"date-time"}
        },
        "additionalProperties":false
      }
    },
    "authority":{"enum":["primary","academic","institutional","reference","journalistic","discovery_only","unknown"]},
    "reliability":{
      "type":"object",
      "properties":{
        "score":{"type":["number","null"],"minimum":0,"maximum":1},
        "notes":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "rights":{"type":["string","null"]},
    "notes":{"type":["string","null"]},
    "status":{"enum":["active","superseded","disputed","unavailable"]},
    "metadata":{
      "type":"object",
      "required":["created_at","updated_at"],
      "properties":{
        "created_at":{"type":"string","format":"date-time"},
        "updated_at":{"type":"string","format":"date-time"}
      },
      "additionalProperties":false
    }
  }
}
