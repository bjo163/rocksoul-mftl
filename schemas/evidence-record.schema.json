{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/evidence-record.schema.json",
  "title": "MFTL Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","target_id","source_id","stance","evidence_type","summary","confidence","metadata"],
  "properties": {
    "schema_version":{"const":"evidence.v0.1"},
    "id":{"type":"string","pattern":"^EVIDENCE-[A-Z0-9-]+$"},
    "target_id":{"type":"string"},
    "source_id":{"type":"string","pattern":"^SOURCE-[A-Z0-9-]+$"},
    "stance":{"enum":["supports","contradicts","contextualizes","neutral","alternative_explanation"]},
    "evidence_type":{"enum":["textual","archaeological","epigraphic","historical","linguistic","scientific","media","testimonial","statistical","other"]},
    "locator":{"type":["string","null"]},
    "summary":{"type":"string","minLength":1},
    "analysis":{"type":["string","null"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "status":{"enum":["unreviewed","sourced","cross_checked","reviewed","disputed"]},
    "metadata":{
      "type":"object",
      "required":["created_at","updated_at"],
      "properties":{
        "created_at":{"type":"string","format":"date-time"},
        "updated_at":{"type":"string","format":"date-time"}
      },
      "additionalProperties":false
    }
  }
}
