{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/deviation-assessment.schema.json",
  "title": "MFTL Reference Deviation Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","target","baseline","observed","deviations","evidence_basis","confidence","review_state"],
  "properties": {
    "schema_version":{"const":"deviation.v0.1"},
    "id":{"type":"string","pattern":"^DEVIATION-[A-Z0-9-]+$"},
    "target":{"type":"object","required":["type","id"],"properties":{"type":{"enum":["claim","narrative","source","practice","record"]},"id":{"type":"string"}},"additionalProperties":false},
    "baseline":{
      "type":"object",
      "required":["type","reference","description"],
      "properties":{
        "type":{"enum":["source_text","canonical_text","historical_record","stated_doctrine","documented_practice","methodological_standard","project_rule","other"]},
        "reference":{"type":"string","minLength":1},
        "description":{"type":"string","minLength":1},
        "framework":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "observed":{"type":"string","minLength":1},
    "deviations":{
      "type":"array","minItems":1,
      "items":{
        "type":"object",
        "required":["code","confidence"],
        "properties":{
          "code":{"type":"string","pattern":"^D[0-9]{2}$"},
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "notes":{"type":["string","null"]}
        },
        "additionalProperties":false
      }
    },
    "evidence_basis":{"type":"array","minItems":1,"items":{"type":"string"}},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "review_state":{"enum":["unreviewed","sourced","cross_checked","reviewed","disputed"]},
    "notes":{"type":["string","null"]}
  }
}
