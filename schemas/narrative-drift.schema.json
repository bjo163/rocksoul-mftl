{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/narrative-drift.schema.json",
  "title": "MFTL Narrative Drift",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "subject_ref",
    "title",
    "stages",
    "drift_observations",
    "guardrails"
  ],
  "properties": {
    "schema_version": {
      "const": "narrative-drift.v0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^DRIFT-[A-Z0-9-]+$"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer",
          "ref",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "drift_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "dimension",
          "change",
          "risk"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
