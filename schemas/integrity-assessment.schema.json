{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mftl.dev/schemas/integrity-assessment.schema.json",
  "title": "MFTL Narrative Integrity Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","target","veracity","intent","distortions","evidence_basis","confidence","review_state"],
  "properties": {
    "schema_version": {"const":"integrity.v0.1"},
    "id": {"type":"string","pattern":"^INTEGRITY-[A-Z0-9-]+$"},
    "target": {
      "type":"object",
      "additionalProperties": false,
      "required":["type","id"],
      "properties":{
        "type":{"enum":["claim","narrative","source","media","record"]},
        "id":{"type":"string"}
      }
    },
    "veracity":{"enum":["unverified","supported","mixed","unsupported","false","indeterminate"]},
    "intent":{"enum":["unknown","unintentional","possibly_deceptive","deceptive","strategic_persuasion","ambiguous"]},
    "distortions":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["code","confidence"],
        "properties":{
          "code":{"type":"string","pattern":"^E[0-9]{2}$"},
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "notes":{"type":["string","null"]}
        }
      }
    },
    "evidence_basis":{"type":"array","minItems":1,"items":{"type":"string"}},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "review_state":{"enum":["unreviewed","sourced","cross_checked","reviewed","disputed"]},
    "notes":{"type":["string","null"]}
  }
}
