  "narrative": {
    "summary": "A Sumerian literary composition in which Inana descends to the underworld, passes through seven gates while regalia are removed, is judged and killed within the narrative, is restored through Enki's intervention, and must provide a substitute in order to ascend.",
    "long_description": "This canonical record describes what the Sumerian textual tradition says. ETCSL provides the scholarly composite text and translation, while CDLI P275004 supplies an Old Babylonian physical manuscript witness from Nippur. The record intentionally separates textual/historical attestation from empirical verification of supernatural events, and it does not collapse the Sumerian composition into the related Akkadian Ištar descent tradition.",
    "motifs": [
      "descent_to_underworld",
      "seven_gates",
      "loss_of_regalia",
      "death_and_restoration",
      "substitution",
      "divine_judgment"
    ]
  },
